import java.util.*;

class Book {
    int id;
    String name;

    Book(int id, String name) {
        this.id = id;
        this.name = name;
    }

    void display() {
        System.out.println(id + " - " + name);
    }
}

public class BookManagement {

    static ArrayList<Book> list = new ArrayList<>();
    static HashMap<Integer, Book> map = new HashMap<>();
    static Scanner sc = new Scanner(System.in);

    // ADD
    static void addBook() {
        System.out.print("Enter Book ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        System.out.print("Enter Book Name: ");
        String name = sc.nextLine();

        Book b = new Book(id, name);

        list.add(b);
        map.put(id, b);

        System.out.println("Book added!");
    }

    // VIEW - Enhanced for loop
    static void viewBooks() {
        System.out.println("\n--- Book List ---");

        for (Book b : list) {
            b.display();
        }
    }

    // UPDATE
    static void updateBook() {
        System.out.print("Enter Book ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        Book b = map.get(id);

        if (b != null) {
            System.out.print("Enter New Book Name: ");
            b.name = sc.nextLine();

            System.out.println("Book updated!");
        } else {
            System.out.println("Book not found!");
        }
    }

    // DETAILS - HashMap lookup
    static void details() {
        System.out.print("Enter Book ID: ");
        int id = sc.nextInt();

        Book b = map.get(id);

        if (b != null)
            b.display();
        else
            System.out.println("Book not found!");
    }

    // DELETE - Iterator
    static void deleteBook() {
        System.out.print("Enter Book ID: ");
        int id = sc.nextInt();

        Iterator<Book> it = list.iterator();

        while (it.hasNext()) {
            Book b = it.next();

            if (b.id == id) {
                it.remove();
                map.remove(id);

                System.out.println("Book deleted!");
                return;
            }
        }

        System.out.println("Book not found!");
    }

    public static void main(String[] args) {

        // 4 default books
        Book b1 = new Book(101, "Java");
        Book b2 = new Book(102, "Python");
        Book b3 = new Book(103, "C Programming");
        Book b4 = new Book(104, "Data Structures");

        list.add(b1);
        list.add(b2);
        list.add(b3);
        list.add(b4);

        map.put(101, b1);
        map.put(102, b2);
        map.put(103, b3);
        map.put(104, b4);

        int choice;

        do {
            System.out.println("\n===== BOOK MANAGEMENT =====");
            System.out.println("1. Add Book");
            System.out.println("2. View Books");
            System.out.println("3. Update Book");
            System.out.println("4. Book Details");
            System.out.println("5. Delete Book");
            System.out.println("6. Exit");

            System.out.print("Enter choice: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    addBook();
                    break;
                case 2:
                    viewBooks();
                    break;
                case 3:
                    updateBook();
                    break;
                case 4:
                    details();
                    break;
                case 5:
                    deleteBook();
                    break;
                case 6:
                    System.out.println("Thank you!");
                    break;
                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 6);

        sc.close();
    }
}
