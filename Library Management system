import java.util.*;

class Book {
    int id;
    String name;

    Book(int id, String name) {
        this.id = id;
        this.name = name;
    }
}

public class BookManagement {
    public static void main(String[] args) {

        ArrayList<Book> list = new ArrayList<>();
        HashMap<Integer, Book> map = new HashMap<>();

        Book b1 = new Book(101, "Java");
        Book b2 = new Book(102, "Python");

        list.add(b1);
        list.add(b2);

        map.put(b1.id, b1);
        map.put(b2.id, b2);

        System.out.println("Books:");
        for (Book b : list)
            System.out.println(b.id + " - " + b.name);

        Book b = map.get(101);
        System.out.println("\nDetails: " + b.id + " - " + b.name);

        b.name = "Advanced Java";
        System.out.println("Updated: " + b.name);

        Iterator<Book> it = list.iterator();

        while (it.hasNext()) {
            Book x = it.next();

            if (x.id == 102) {
                it.remove();
                map.remove(102);
            }
        }
        System.out.println("\nAfter Delete:");
        for (Book x : list)
            System.out.println(x.id + " - " + x.name);
    }
}
